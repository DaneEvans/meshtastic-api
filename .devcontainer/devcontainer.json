{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "pnpm i; apt install postgresql",
  "features": {
    "ghcr.io/itsmechlark/features/postgresql:1": {
      "version": "16",
      "postgresql-password": "postgres",
      "postgresql-db": "meshtastic"
    }
  },
  "customizations": {},
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/meshtastic"
  }
}
